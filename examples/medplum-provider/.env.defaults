# Afiax Provider settings. Vite copies this file to .env when no .env exists.
# Set the real values per environment (for example in the build or deployment pipeline).
# The FHIR server (trailing slash required)
MEDPLUM_BASE_URL=http://localhost:8103/
# The ClientApplication this app signs in with (its redirect URI must be this app's address)
MEDPLUM_CLIENT_ID=
# The admin app, for links to admin-only screens (staff invites, country pack settings). Empty hides them.
MEDPLUM_ADMIN_APP_URL=
# The user guides (Help on the Get started page). Empty hides the link.
MEDPLUM_HELP_URL=https://www.fhirdocs.afiax.africa/docs/user-guides/
# Afiax support e-mail. Empty shows "contact your Afiax administrator".
MEDPLUM_SUPPORT_EMAIL=
