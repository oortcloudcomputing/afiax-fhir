{
  "$schema": "https://turborepo.org/schema.json",
  "globalEnv": ["NODE_VERSION", "MEDPLUM_GIT_SHORTHASH", "WEBSITE_ALLOWED_DEV_ORIGINS"],
  "tasks": {
    "clean": {
      "outputs": ["build/**", "dist/**", "coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "MEDPLUM_BASE_URL",
        "MEDPLUM_CLIENT_ID",
        "MEDPLUM_REGISTER_ENABLED",
        "MEDPLUM_PROJECT_ID",
        "MEDPLUM_ADMIN_APP_URL",
        "MEDPLUM_HELP_URL",
        "MEDPLUM_SUPPORT_EMAIL",
        "MEDPLUM_AWS_TEXTRACT_ENABLED",
        "MEDPLUM_IDLE_TIMEOUT_MINUTES",
        "GOOGLE_CLIENT_ID",
        "RECAPTCHA_SITE_KEY"
      ]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"],
      "inputs": ["src/**/*.tsx", "src/**/*.ts"]
    },
    "lint": {
      "dependsOn": ["build"]
    },
    "lint:fix": {
      "dependsOn": ["build"]
    }
  }
}
